# Google Sheet source configuration.
# The app pulls this sheet LIVE on every request (no persistent cache).

# Spreadsheet ID (from the sheet URL: /spreadsheets/d/<THIS>/edit)
SHEET_ID=1B3FggMT8nM0XJoUP7DcM-ehpsGOc0_VSZtQrtxHQ78k

# The gid of the tab that holds the RAW vehicle-recovery data.
RAW_GID=498750883

# Optional: comma-separated "Label:gid" pairs for additional raw tabs to expose.
# Example: EXTRA_SHEETS=Archive:123456789,Q1:987654321
EXTRA_SHEETS=

# Server port (serves API + built frontend in production).
PORT=3001

# Seconds to dedupe concurrent identical fetches. 0 = always fetch fresh.
# Kept tiny so every open still reflects the live sheet.
FETCH_DEDUPE_SECONDS=0
